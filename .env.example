# Copy to .env and fill in values before running docker-compose up

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=postgres
DB_PORT=15432

# API
API_PORT=5500

# API key auth — comma-separated list of bearer tokens for /v1/ endpoints
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GOLFMIKE_API_KEYS=

# Solace PubSub+ (FAA SWIM) — shared across all consumers
SWIM_HOST=tcps://ems2.swim.faa.gov:55443
SWIM_USERNAME=gear.twinhawk.co
SWIM_PASSWORD=

# SWIM queue names (one per VPN subscription)
TFMS_VPN=TFMS
TFMS_QUEUE=gear.twinhawk.co.TFMS.39cf9ef5-e72e-4d5c-bd12-f700b6b725c3.OUT

FDPS_VPN=FDPS
FDPS_QUEUE=gear.twinhawk.co.FDPS.4de2dd99-fd7d-4246-9460-8c32dfdcfede.OUT

ITWS_VPN=ITWS
ITWS_QUEUE=gear.twinhawk.co.ITWS.35078235-3acd-40a5-931f-f9e15c04f7da.OUT

TBFM_VPN=TBFM
TBFM_QUEUE=gear.twinhawk.co.TBFM.73a8d366-e856-4085-a58a-fa7ec3214bd1.OUT

# Apprise notification URLs (comma-separated, any Apprise-compatible URL)
# Examples: slack://tokenA/tokenB/tokenC  discord://webhook_id/webhook_token
#           ntfy://my-ntfy-server/topic   mailto://user:pass@gmail.com
APPRISE_URLS=

# Flower monitoring UI credentials
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
FLOWER_PORT=5555
