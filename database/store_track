from sqlalchemy import insert, exc
from sqlalchemy.orm import Session
from models.pydantic_models import TrackDBModel, FltdMessageDBModel
from models.track_models import TrackInformation
import logging

logger = logging.getLogger(__name__)


def store_track(session: Session, track: TrackInformation):
    try:
        track_data = track.dict(exclude_unset=True)  # Exclude unset attributes
        stmt = insert(TrackDBModel.__table__).values(**track_data)
        session.execute(stmt)
        session.commit()
        logger.info("Successfully stored track data.")
    except exc.IntegrityError as e:
        logger.error(f"Integrity error storing track: {e}", exc_info=True)
        session.rollback()
    except Exception as e:
        logger.error(f"Error storing track: {e}", exc_info=True)
        session.rollback()


def store_fltd_message(session: Session, message: FltdMessage):
    try:
        message_data = message.dict()
        stmt = insert(FltdMessageDBModel.__table__).values(**message_data)
        update_dict = {c.name: c for c in stmt.excluded}
        update_stmt = stmt.on_conflict_do_update(
            index_elements=["id"], set_=update_dict
        )
        session.execute(update_stmt)
        session.commit()
        logger.info("Successfully stored fltdMessage data.")
    except exc.IntegrityError as e:
        logger.error(f"Integrity error storing fltdMessage: {e}", exc_info=True)
        session.rollback()
    except Exception as e:
        logger.error(f"Error storing fltdMessage: {e}", exc_info=True)
        session.rollback()
