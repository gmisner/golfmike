<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns:ds="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns:fdm="urn:us:gov:dot:faa:atm:tfm:flightdata"
            xmlns:nxce="urn:us:gov:dot:faa:atm:tfm:tfmdatacoreelements"
            xmlns:nxcm="urn:us:gov:dot:faa:atm:tfm:flightdatacommonmessages"
            elementFormDefault="qualified">

  <xsd:element name="tfmDataService" type="ds:TfmDataServiceType"/>

  <xsd:complexType name="TfmDataServiceType">
    <xsd:sequence>
      <xsd:element name="fltdOutput" type="fdm:FltdOutputType"/>
    </xsd:sequence>
    <xsd:attribute name="xsi:schemaLocation" type="xsd:string"/>
  </xsd:complexType>

  <xsd:complexType name="FltdOutputType">
    <xsd:sequence>
      <xsd:element name="fltdMessage" type="fdm:FltdMessageType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FltdMessageType">
    <xsd:sequence>
      <xsd:element name="ncsmFlightSectors" type="fdm:NcsmFlightSectorsType"/>
    </xsd:sequence>
    <xsd:attribute name="acid" type="xsd:string"/>
    <xsd:attribute name="airline" type="xsd:string"/>
    <xsd:attribute name="arrArpt" type="xsd:string"/>
    <xsd:attribute name="cdmPart" type="xsd:boolean"/>
    <xsd:attribute name="depArpt" type="xsd:string"/>
    <xsd:attribute name="fdTrigger" type="xsd:string"/>
    <xsd:attribute name="flightRef" type="xsd:string"/>
    <xsd:attribute name="major" type="xsd:string"/>
    <xsd:attribute name="msgType" type="xsd:string"/>
    <xsd:attribute name="sensitivity" type="xsd:string"/>
    <xsd:attribute name="sourceFacility" type="xsd:string"/>
    <xsd:attribute name="sourceTimeStamp" type="xsd:dateTime"/>
  </xsd:complexType>

  <xsd:complexType name="NcsmFlightSectorsType">
    <xsd:sequence>
      <xsd:element name="qualifiedAircraftId" type="nxcm:QualifiedAircraftIdType"/>
      <xsd:element name="flightTraversalData2" type="nxcm:FlightTraversalData2Type"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="QualifiedAircraftIdType">
    <xsd:sequence>
      <xsd:element name="aircraftId" type="nxce:AircraftIdType"/>
      <xsd:element name="computerId" type="nxce:ComputerIdType"/>
      <xsd:element name="igtd" type="xsd:dateTime"/>
      <xsd:element name="departurePoint" type="nxce:PointType"/>
      <xsd:element name="arrivalPoint" type="nxce:PointType"/>
    </xsd:sequence>
    <xsd:attribute name="aircraftCategory" type="xsd:string"/>
    <xsd:attribute name="userCategory" type="xsd:string"/>
  </xsd:complexType>

  <xsd:complexType name="FlightTraversalData2Type">
    <xsd:sequence>
      <xsd:element name="fix" type="nxce:FixType" maxOccurs="unbounded"/>
      <xsd:element name="waypoint" type="nxce:WaypointType" maxOccurs="unbounded"/>
      <xsd:element name="airway" type="nxce:AirwayType" maxOccurs="unbounded"/>
      <xsd:element name="center" type="nxce:CenterType" maxOccurs="unbounded"/>
      <xsd:element name="sector" type="nxce:SectorType" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FixType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="sequenceNumber" type="xsd:int"/>
        <xsd:attribute name="elapsedTime" type="xsd:int"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="WaypointType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="latitudeDecimal" type="xsd:decimal"/>
        <xsd:attribute name="longitudeDecimal" type="xsd:decimal"/>
        <xsd:attribute name="sequenceNumber" type="xsd:int"/>
        <xsd:attribute name="elapsedTime" type="xsd:int"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="AirwayType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="sequenceNumber" type="xsd:int"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="CenterType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="sequenceNumber" type="xsd:int"/>
        <xsd:attribute name="elapsedEntryTime" type="xsd:int"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="SectorType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="sequenceNumber" type="xsd:int"/>
        <xsd:attribute name="elapsedEntryTime" type="xsd:int"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="PointType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="AircraftIdType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="ComputerIdType">
    <xsd:sequence>
      <xsd:element name="facilityIdentifier" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>
