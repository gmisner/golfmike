<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns:ns2="urn:us:gov:dot:faa:atm:tfm:flightdatacommonmessages"
            xmlns:ns3="urn:us:gov:dot:faa:atm:tfm:flightdata"
            xmlns:ns4="urn:us:gov:dot:faa:atm:tfm:ficommondatatypes"
            xmlns:ns5="urn:us:gov:dot:faa:atm:tfm:tfmdataservice"
            xmlns:ns6="http://www.fixm.aero/tfm/3.1"
            xmlns:ns7="urn:us:gov:dot:faa:atm:tfm:tfmdatacoreelements"
            xmlns:ns8="http://www.faa.aero/nas/3.1"
            xmlns:ns9="urn:us:gov:dot:faa:atm:tfm:ficommonmessages2"
            xmlns:ns10="urn:us:gov:dot:faa:atm:tfm:tfmrequestreplytypes"
            xmlns:ns11="urn:us:gov:dot:faa:atm:tfm:ficommonmessages"
            xmlns:ns12="urn:us:gov:dot:faa:atm:tfm:flowinformation"
            xmlns:ns13="urn:us:gov:dot:faa:atm:tfm:rapttimeline"
            xmlns:ns14="http://www.fixm.aero/flight/3.0"
            xmlns:ns15="http://www.fixm.aero/base/3.0"
            xmlns:ns16="http://www.fixm.aero/foundation/3.0"
            elementFormDefault="qualified">

  <xsd:element name="tfmDataService" type="ns5:TfmDataServiceType"/>

  <xsd:complexType name="TfmDataServiceType">
    <xsd:sequence>
      <xsd:element name="fiOutput" type="ns5:FiOutputType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FiOutputType">
    <xsd:sequence>
      <xsd:element name="fiMessage" type="ns12:FiMessageType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FiMessageType">
    <xsd:sequence>
      <xsd:element name="tmiFlightDataList" type="ns12:TmiFlightDataListType"/>
    </xsd:sequence>
    <xsd:attribute name="sensitivity" type="xsd:string"/>
    <xsd:attribute name="visDomain" type="xsd:string"/>
    <xsd:attribute name="destinationCodes" type="xsd:string"/>
    <xsd:attribute name="sourceFacility" type="xsd:string"/>
    <xsd:attribute name="sourceTimeStamp" type="xsd:dateTime"/>
    <xsd:attribute name="msgType" type="xsd:string"/>
  </xsd:complexType>

  <xsd:complexType name="TmiFlightDataListType">
    <xsd:sequence>
      <xsd:element name="flightData" type="ns12:FlightDataType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FlightDataType">
    <xsd:sequence>
      <xsd:element name="flight" type="ns9:FlightType"/>
      <xsd:element name="flightReference" type="xsd:string"/>
      <xsd:element name="status" type="xsd:string"/>
      <xsd:element name="tmiFlightInfoList" type="ns9:TmiFlightInfoListType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FlightType">
    <xsd:sequence>
      <xsd:element name="aircraftId" type="xsd:string"/>
      <xsd:element name="gufi" type="xsd:string"/>
      <xsd:element name="igtd" type="xsd:dateTime"/>
      <xsd:element name="departurePoint" type="ns7:PointType"/>
      <xsd:element name="arrivalPoint" type="ns7:PointType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="PointType">
    <xsd:sequence>
      <xsd:element name="airport" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="TmiFlightInfoListType">
    <xsd:sequence>
      <xsd:element name="tmi" type="ns9:TmiType"/>
      <xsd:element name="fxaFlightData" type="ns9:FxaFlightDataType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="TmiType">
    <xsd:sequence>
      <xsd:element name="fcaId" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attribute name="updateType" type="xsd:string"/>
    <xsd:attribute name="lastUpdateTime" type="xsd:dateTime"/>
  </xsd:complexType>

  <xsd:complexType name="FxaFlightDataType">
    <xsd:sequence>
      <xsd:element name="fxaFlight" type="ns9:FxaFlightType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FxaFlightType">
    <xsd:sequence>
      <xsd:element name="fxaId" type="ns9:FxaIdType"/>
      <xsd:element name="bentryTm" type="xsd:dateTime"/>
      <xsd:element name="createTm" type="xsd:dateTime"/>
      <xsd:element name="eentryTm" type="xsd:dateTime"/>
      <xsd:element name="entryTm" type="xsd:dateTime"/>
      <xsd:element name="exitTm" type="xsd:dateTime"/>
      <xsd:element name="extendedExitTm" type="xsd:dateTime"/>
      <xsd:element name="ientryTm" type="xsd:dateTime"/>
      <xsd:element name="oentryTm" type="xsd:dateTime"/>
      <xsd:element name="entryLat" type="xsd:decimal"/>
      <xsd:element name="entryLon" type="xsd:decimal"/>
      <xsd:element name="entryHeading" type="xsd:int"/>
      <xsd:element name="exitInd" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="FxaIdType">
    <xsd:sequence>
      <xsd:element name="fcaId" type="xsd:string"/>
      <xsd:element name="fcaName" type="xsd:string"/>
      <xsd:element name="lastUpdate" type="xsd:dateTime"/>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>
